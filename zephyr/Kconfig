menuconfig CMSIS_EXECUTORCH
	bool "CMSIS-ExecuTorch runtime and selected operators"
	depends on CPP
	depends on STD_CPP_VERSION >= 201703
	depends on !EXECUTORCH
	select REQUIRES_FULL_LIBCPP
	help
	  Compile runtime and selected operator sources from the installed
	  ExecuTorch Zephyr module, using pre-generated headers supplied here.
	  Keep CONFIG_EXECUTORCH disabled: its upstream build is not used.
	  No host tools are compiled and no operator code generator is run.
	  Enable C++ and select C++17 or a newer standard in the application.

if CMSIS_EXECUTORCH

rsource "Kconfig.components"

rsource "Kconfig.operators"

config CMSIS_EXECUTORCH_EMBEDDED_MODULE
	bool "Arm EmbeddedModule facade"
	default y
	select CMSIS_EXECUTORCH_RUNTIME
	help
	  Include arm::embedded::EmbeddedModule from this project's src directory.
	  The caller supplies a data loader and memory allocators for its model.

rsource "Kconfig.executorch"

endif # CMSIS_EXECUTORCH
